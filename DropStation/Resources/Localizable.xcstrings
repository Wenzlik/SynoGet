    "Your SID is stored in the iOS Keychain so the app stays signed in across launches.": {
      "extractionState": "stale",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše SID je uloženo v iOS Klíčence, takže aplikace zůstává přihlášena i po restartu."
          }
        }
      }
    },
    "Your session and password are stored in the iOS Keychain. When the session expires you'll only be asked for your verification code, not your password.": {
      "comment": "Helper text in the Settings view explaining the privacy policy for the session and password.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace a heslo se ukládají do Klíčenky iOS. Po vypršení relace zadáte pouze ověřovací kód, nikoli heslo."
          }
        }
      }
    },
    "Your session is saved. We’ll reconnect automatically when the NAS is reachable.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše relace je uložena. Znovu se připojíme automaticky, jakmile bude NAS dostupný."
          }
        }
      }
    },
    "Your session is stored in the iOS Keychain so the app stays signed in across launches. Your password is not saved.": {
      "comment": "Helper text under the Privacy section, describing the session and password storage.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Relace se ukládá do Klíčenky iOS, takže zůstanete přihlášeni i po opětovném spuštění. Heslo se neukládá."
          }
        }
      }
    },

    "DropStation can't verify %@'s certificate against a trusted authority. Synology NAS devices ship with a self-signed certificate by default. If you recognise this server, trust the certificate to continue.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DropStation nemůže ověřit certifikát serveru %@ proti důvěryhodné autoritě. Zařízení Synology NAS se ve výchozím nastavení dodávají s vlastním self-signed certifikátem. Pokud tento server znáte, důvěřujte certifikátu pro pokračování."
          }
        }
      }
    },
